DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /think/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /think/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Mic + camera for Live Voice (and QR/biometric Netzar). Scoped to /think/ only.
  Header unset Permissions-Policy
  Header set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
</IfModule>
